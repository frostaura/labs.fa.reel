{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // An export that its own module also uses is a deliberate seam (tests, docs, a named constant),
  // not dead code; knip still reports exports that nothing uses at all.
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // Generated by `npm run gen:api` (openapi-typescript). The emitted module shape is the tool's,
    // and the contract test reads it through `components`; hand-pruning it would be undone by
    // the next regeneration.
    "src/store/generated/openapi.ts": ["types"],
    // TEMPORARY, each an open change request to the file's owner (trust-v1 R1-31). Each export is
    // referenced nowhere. Delete the entry in the same commit that removes the dead export.
    // WS-10B: GENRE_STATE_LABEL is unused.
    "src/lib/pickConditions.ts": ["exports"],
    // WS-10A: GATING_DEMOTE_ONLY is unused.
    "src/lib/xrefCopy.ts": ["exports"]
  }
}
