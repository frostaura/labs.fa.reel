{
  "name": "fa.reel-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test -c playwright.preview.config.ts",
    "audit:gate": "node scripts/audit-gate.mjs",
    "gen:api": "MSBuildEnableWorkloadResolver=false dotnet build ../backend/FrostAura.Reel.Api/FrostAura.Reel.Api.csproj --nologo --no-incremental -p:OpenApiGenerateDocuments=true && openapi-typescript openapi/reel-api.json -o src/store/generated/openapi.ts"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.1.2",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "knip": "6.43.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^13.0.6",
      "source-map": "^0.8.0"
    },
    "tailwindcss": {
      "postcss-nested": "^7.0.2",
      "postcss-selector-parser": "^7.1.7"
    }
  },
  "allowScripts": {
    "fsevents": false
  }
}
