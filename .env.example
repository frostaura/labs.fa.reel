# fa.reel — Environment Variables
# Copy to .env and fill in values before running docker-compose.

# PostgreSQL (pgvector/pgvector:pg16)
POSTGRES_USER=reel
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=reel

# Backend API
ASPNETCORE_ENVIRONMENT=Development
# Local docker-compose publishes Postgres on 5433 (5432 is usually already taken on a dev machine).
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=reel;Username=reel;Password=REPLACE_WITH_STRONG_DB_PASSWORD
Database__AutoMigrateOnStartup=true

# JWT / app session (Sign in with Trakt mints these; fa.startup naming)
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET_VALUE
JWT_ISSUER=frostaura-reel
JWT_AUDIENCE=frostaura-reel-app
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Trakt — create an app at https://trakt.tv/oauth/applications
# Redirect URIs: https://reel.frostaura.net/auth/trakt/callback (prod)
#                http://localhost:5173/auth/trakt/callback (dev)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=http://localhost:5173/auth/trakt/callback
TRAKT_RATE_BUDGET_PER_5MIN=900
# Dev/test profile — POST /api/auth/dev/link (Development + QA_HELPERS_ENABLED=true, loopback callers
# only) issues a session for this profile. {"noCascade":true} issues one without linking, writing the
# tier or starting any sync job. Never set these in a production descriptor.
QA_HELPERS_ENABLED=false
TRAKT_DEV_PROFILE=deanmar09
TRAKT_ACCESS_TOKEN=
TRAKT_REFRESH_TOKEN=

# TMDB — https://www.themoviedb.org/settings/api (use the v4 Read Access Token)
TMDB_READ_ACCESS_TOKEN=
TMDB_RATE_PER_SEC=40

# OpenRouter (LLM gateway — per-title attribute extraction; fa.startup naming)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_CONCURRENCY=4
# Conversational Ask Reel model (optional; defaults to OPENROUTER_MODEL)
REEL_SEARCH_MODEL=

# Stripe billing (optional — leave blank to run free; set all three to enable paid plans)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Embeddings — OpenAI-compatible /embeddings served by OpenRouter (text-embedding-3-small @ 1536d;
# founder-locked 2026-06-12). EMBEDDINGS_BASE_URL must point at OpenRouter, not api.openai.com.
# EMBEDDINGS_API_KEY is optional: it falls back to OPENROUTER_API_KEY (same gateway).
# (EMBEDDINGS_PROVIDER and EMBEDDINGS_DIMENSIONS were removed: no code read either.)
EMBEDDINGS_MODEL=openai/text-embedding-3-small
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_API_KEY=

# Sync cadence
SYNC_DELTA_MINUTES=15
SYNC_HOT_MINUTES=5
RETRAIN_MIN_NEW_RATINGS=10

# Region default when the CF-IPCountry header is absent (dev)
GEOIP_DEFAULT_REGION=US

# Web
APP_PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Test helpers — deterministic LLM stub (never hits the network when true)
TestHelpers__ModelStubMode=false

# Gateway (nginx reverse proxy)
# Published on loopback only unless GATEWAY_BIND opts in. On 2026-10-22 a gateway on 0.0.0.0 handed a
# Founder session to the LAN (J-1). For phone QA on the LAN set GATEWAY_BIND=0.0.0.0, then unset it.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=5173
# Postgres is published for host-side tools only, on its own bind variable so opening the gateway
# never opens the database.
POSTGRES_BIND=127.0.0.1
POSTGRES_HOST_PORT=5433
NGINX_BACKEND_PORT=5000
NGINX_FRONTEND_PORT=80
NGINX_CLIENT_MAX_BODY_SIZE=10m

# Online experiment — team-draft interleaving (docs/interleaving.md)
# Off by default: with INTERLEAVE_ENABLED unset or false the feed is exactly its usual self and
# nothing is attributed. A = CalibratedModel, B = PopularityBaseline is the honest first comparison.
# Expect two to three months per comparison; the /lab panel reports the live estimate.
INTERLEAVE_ENABLED=false
INTERLEAVE_POLICY_A=CalibratedModel
INTERLEAVE_POLICY_B=PopularityBaseline

# Catalogue bulk seed and its follow-through (POST /api/dev/seed-catalog)
# The seed walks TMDB discover by vote_count.desc, one query per (medium, release year) from 1990,
# and upserts summary rows. Measured against TMDB on 2026-09-10, the floors below yield ~9,300
# titles over ~503 pages; movies=50 / shows=50 yields ~34,800 over ~1,775 pages. Lower floors buy
# more of the tail AND more rows nobody will ever be shown, and every one of them costs a hydration
# call and an extraction — so the shipped default is the conservative end.
SEED_MOVIE_MIN_VOTES=500
SEED_SHOW_MIN_VOTES=200
SEED_PAGES_PER_RUN=400
SEED_MAX_TITLES=60000

# Daily ceilings on completing what the seed lands. Hydration is counted in TITLES because TMDB is
# free within the rate gate; enrichment is counted in TOKENS against the ExternalApiUsages ledger,
# system-wide rather than per account, because a Title row is shared by every tenant.
# EXTRACT_DAILY_TOKENS 1,500,000 at gpt-6-luna input pricing (~$0.10/M) is ~$0.15/day and, at
# ~1,100 tokens per extraction, buys ~1,360 titles a day. EMBED_DAILY_TOKENS 3,000,000 on
# text-embedding-3-small (~$0.02/M) is ~$0.06/day and ~23,000 titles a day. Both are read fresh on
# every job, so raising either takes effect on the next run.
HYDRATE_MAX_TITLES_PER_DAY=1500
EXTRACT_DAILY_TOKENS=1500000
EMBED_DAILY_TOKENS=3000000

# Cross-reference rounds (per account per day, BOTH binding)
# A batch of 60 candidates costs roughly 11k prompt + 2.7k completion tokens. The founder's eligible
# pool today is ~2,242 titles: 38 round-1 calls (~545k tokens) plus 23 round-2 calls (~330k) is one
# complete cold pass at ~68 calls and ~895k tokens. So 80/1,200,000 admits today's whole pool in a
# day with margin, and paces a 10,000-title pool over roughly four days with an honest counter — the
# trade the founder asked for. Both ceilings bind (&&) and are re-checked PER BATCH, because a run
# that starts inside its budget can spend past it inside a single 15-second ledger window. The
# offline backtest bills to `cross-reference-eval`, not `cross-reference`, so validating the judge
# can never consume the budget the judge runs on.
#
# UNHELD AT A MODEST BUDGET, 2026-09-11. The pass ran at zero from 2026-09-10 because prompt v1's
# `out` verdict ruled out the founder's future loves and future dislikes at the same rate, so
# nothing it wrote could be allowed to move a pick. Prompt v2 changed the answer on the KEEP side —
# measured on his own holdout, five split origins pooled: AUC 0.655 against v1's 0.611, keeps later
# averaging 6.83 against 6.16 for rule-outs, keep -> loved 33.2% and keep -> disliked 8.1% against
# base rates of roughly 23% and 15%. So v2 is what the job writes, a keep lifts the rank key by at
# most a fifth, and an `out` still does nothing at all (16.2% [12.3, 21.0] of future loves against
# 22.8% of future dislikes has not earned a demotion, let alone a hero bar).
#
# 40 rather than 80 as the suggested DEV value, deliberately: at batch 60 that is ~2,400 candidates
# a day, which covers the founder's eligible pool in roughly one to two runs and still paces a cold
# pass over a pool that has grown past 3,700 — while halving what a bug can spend before anyone
# looks. The ~$0.14 whole-pass figure below is what the ceiling is measured against, not a target.
# Raise it once a full pass has run cleanly and the ledger agrees with the arithmetic.
LLM_XREF_DAILY_CALLS=40
LLM_XREF_DAILY_TOKENS=1200000

# The re-rank FAMILY ceiling (per account per day) — one budget across rerank-feed, rerank-page,
# rerank-ask and rerank-expand, plus the legacy `rerank` rows so a day with real spend on it cannot
# read as empty. One ceiling rather than four, because four independent ceilings sum to four times
# the number anyone signed off on. Measured 2026-09-10: 167 calls / 298k tokens over three days,
# i.e. ~56 calls and ~100k tokens on a busy day; the defaults are ~2.7x that. Background re-ranking
# (the feed build's three passes — nobody is waiting on them) stops at 70% of both, so a 3 a.m.
# build can never starve an Ask Reel turn later the same day; Ask Reel and the paginator get 100%.
# Exhaustion is never an error: every re-rank caller already degrades to model order.
LLM_RERANK_DAILY_CALLS=150
LLM_RERANK_DAILY_TOKENS=300000

# Lens copy (per account per day, BOTH binding). Exhaustion falls back to the stale note, then the
# templater, then the overview.
LLM_LENS_DAILY_CALLS=60
LLM_LENS_DAILY_TOKENS=120000

# Every LLM ceiling above is printed, as the process actually resolved it, in one startup log line
# beginning "Effective LLM ceilings". Blank or absent means the code default.

# Model and experiment switches (CLAUDE.md "Runtime flags"; blank or absent means the code default)
# CALIBRATOR_MODE: auto | shift | isotonic | off
CALIBRATOR_MODE=
RESIDUAL_HEAD_ENABLED=
RESIDUAL_OBSERVE_TRAKT_RATINGS=
INTERLEAVE_ALPHA=
INTERLEAVE_MSPRT_TAU=
KILL_CRITERION_ITERATIONS=3
ASK_RETENTION_DAYS=
ENRICH_MAX_TITLES_PER_RUN=

# Background loops — each one a kill switch (true/false; read with typed parsing, so never blank).
Background__JobRunner=true
Background__DeltaPoll=true
Background__TokenRefresh=true
Background__OutboxDispatcher=true
Background__NightlyReconcile=true
Background__Digest=true
Background__CatalogGrowth=true
Background__CatalogFollowThrough=true
Background__LanguageBackfill=true

# Web push VAPID subject (a mailto: or https: URL identifying the sender)
Push__Subject=https://reel.frostaura.net

# Backups (docs/deployment.md#backups-and-restore). The backup service dumps nightly at
# BACKUP_HOUR_UTC with pg_dump -Fc, keeps 14 daily and 8 weekly, and answers the backend's request for
# a dump before it applies a pending migration. Dumps live in BACKUP_HOST_DIR: ~/.reel/backups by
# default for the dev compose file (outside the repository); REQUIRED in the prod/Portainer stacks,
# as an absolute host path, ideally a mount of off-host storage (FD-12). Never a volume of the stack.
BACKUP_HOST_DIR=
BACKUP_HOUR_UTC=2
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_PRE_MIGRATION=10
# Set inside the compose files (the shared volume's mount point); only a host-side run would set it.
# BACKUP_REQUEST_DIR=/backup-requests
# 30 to 1800 seconds. The backend healthcheck's 40-minute start_period is sized to this maximum.
BACKUP_PRE_MIGRATION_TIMEOUT_SECONDS=1800
# true: the API refuses to migrate (and exits) when the pre-migration dump fails or goes unanswered.
BACKUP_PRE_MIGRATION_REQUIRED=true

# Frontend dev
VITE_API_TARGET=http://127.0.0.1:5000

# CI/deploy (GitHub repo secrets, not local env): DOCKERHUB_USERNAME, DOCKERHUB_TOKEN,
# PORTAINER_URL, PORTAINER_TOKEN, PORTAINER_ENDPOINT_ID, PORTAINER_STACK_ID
